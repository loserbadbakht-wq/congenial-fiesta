{
  "manifest_version": 3,
  "name": "Gamefa Video.js Player",
  "short_name": "Gamefa VJS",
  "version": "1.0.0",
  "description": "Replaces native video and audio players on Gamefa group pages with Video.js 10 custom elements.",
  "browser_specific_settings": {
    "gecko": {
      "id": "gamefa-videojs@example.com",
      "strict_min_version": "128.0"
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://gamefa.com/groups/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": []
}
