{
  "manifest_version": 3,
  "name": "Gamefa Video.js Player",
  "short_name": "Gamefa VJS",
  "version": "1.0.0",
  "description": "Replaces native video and audio players on Gamefa group pages with Video.js 10 custom elements.",
  "minimum_chrome_version": "111",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://gamefa.com/groups/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "permissions": []
}
