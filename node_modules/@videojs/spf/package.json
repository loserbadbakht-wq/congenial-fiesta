{
  "name": "@videojs/spf",
  "version": "10.1.0",
  "description": "Stream Processing Framework for Video.js 10",
  "keywords": [
    "hls",
    "spf",
    "streaming",
    "video",
    "videojs"
  ],
  "homepage": "https://videojs.org",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/video.js",
    "directory": "packages/spf"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/default/index.js",
  "module": "dist/default/index.js",
  "types": "dist/dev/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dev/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/default/index.js"
    },
    "./dom": {
      "types": "./dist/dev/dom.d.ts",
      "development": "./dist/dev/dom.js",
      "default": "./dist/default/dom.js"
    },
    "./hls": {
      "types": "./dist/dev/hls.d.ts",
      "development": "./dist/dev/hls.js",
      "default": "./dist/default/hls.js"
    },
    "./media-tracks": {
      "types": "./dist/dev/media-tracks.d.ts",
      "development": "./dist/dev/media-tracks.js",
      "default": "./dist/default/media-tracks.js"
    },
    "./hls-background-video": {
      "types": "./dist/dev/hls-background-video.d.ts",
      "development": "./dist/dev/hls-background-video.js",
      "default": "./dist/default/hls-background-video.js"
    },
    "./hls-audio": {
      "types": "./dist/dev/hls-audio.d.ts",
      "development": "./dist/dev/hls-audio.js",
      "default": "./dist/default/hls-audio.js"
    },
    "./hls-video": {
      "types": "./dist/dev/hls-video.d.ts",
      "development": "./dist/dev/hls-video.js",
      "default": "./dist/default/hls-video.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@videojs/media": "10.1.0",
    "@videojs/utils": "10.1.0",
    "signal-polyfill": "^0.2.2"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "5.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "playwright": "^1.59.1",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1"
  },
  "scripts": {
    "build:watch": "vp pack --watch ./src --no-clean",
    "dev": "pnpm run build:watch",
    "test": "vp test run",
    "test:watch": "vp test",
    "clean": "rimraf --glob dist types '*.tsbuildinfo' 'src/**/*.tsbuildinfo'",
    "size": "node scripts/measure-size.js --hls",
    "size:all": "node scripts/measure-size.js --all"
  }
}