{
  "name": "@videojs/html",
  "version": "10.1.0",
  "description": "Video.js 10 for HTML, Vue, and Svelte: player custom elements and skins for video and audio",
  "keywords": [
    "audio",
    "components",
    "custom-elements",
    "html",
    "media",
    "player",
    "svelte",
    "ui",
    "video",
    "video-player",
    "video.js",
    "videojs",
    "vue",
    "web-components"
  ],
  "homepage": "https://videojs.org",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/videojs/video.js",
    "directory": "packages/html"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/*/define/**/*.js",
    "./dist/*/internal/skins/*/register.js",
    "./dist/*/i18n/index.js",
    "./dist/*/i18n/locales/*/register.js",
    "./dist/*/icons/element/**/*.js",
    "./dist/*/icons/dist/element/**/*.js"
  ],
  "main": "dist/default/index.js",
  "module": "dist/default/index.js",
  "types": "dist/dev/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/dev/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/default/index.js"
    },
    "./icons": {
      "types": "./dist/dev/icons/index.d.ts",
      "development": "./dist/dev/icons/index.js",
      "default": "./dist/default/icons/index.js"
    },
    "./icons/*": {
      "types": "./dist/dev/icons/*/index.d.ts",
      "development": "./dist/dev/icons/*/index.js",
      "default": "./dist/default/icons/*/index.js"
    },
    "./video": {
      "types": "./dist/dev/presets/video/index.d.ts",
      "development": "./dist/dev/presets/video/index.js",
      "default": "./dist/default/presets/video/index.js"
    },
    "./video/*.css": "./dist/default/define/video/*.css",
    "./video/*": {
      "types": "./dist/dev/define/video/*.d.ts",
      "development": "./dist/dev/define/video/*.js",
      "default": "./dist/default/define/video/*.js"
    },
    "./audio": {
      "types": "./dist/dev/presets/audio/index.d.ts",
      "development": "./dist/dev/presets/audio/index.js",
      "default": "./dist/default/presets/audio/index.js"
    },
    "./audio/*.css": "./dist/default/define/audio/*.css",
    "./audio/*": {
      "types": "./dist/dev/define/audio/*.d.ts",
      "development": "./dist/dev/define/audio/*.js",
      "default": "./dist/default/define/audio/*.js"
    },
    "./background": {
      "types": "./dist/dev/presets/background/index.d.ts",
      "development": "./dist/dev/presets/background/index.js",
      "default": "./dist/default/presets/background/index.js"
    },
    "./background/*.css": "./dist/default/define/background/*.css",
    "./background/*": {
      "types": "./dist/dev/define/background/*.d.ts",
      "development": "./dist/dev/define/background/*.js",
      "default": "./dist/default/define/background/*.js"
    },
    "./live-video": {
      "types": "./dist/dev/presets/live-video/index.d.ts",
      "development": "./dist/dev/presets/live-video/index.js",
      "default": "./dist/default/presets/live-video/index.js"
    },
    "./live-video/*.css": "./dist/default/define/live-video/*.css",
    "./live-video/*": {
      "types": "./dist/dev/define/live-video/*.d.ts",
      "development": "./dist/dev/define/live-video/*.js",
      "default": "./dist/default/define/live-video/*.js"
    },
    "./live-audio": {
      "types": "./dist/dev/presets/live-audio/index.d.ts",
      "development": "./dist/dev/presets/live-audio/index.js",
      "default": "./dist/default/presets/live-audio/index.js"
    },
    "./live-audio/*.css": "./dist/default/define/live-audio/*.css",
    "./live-audio/*": {
      "types": "./dist/dev/define/live-audio/*.d.ts",
      "development": "./dist/dev/define/live-audio/*.js",
      "default": "./dist/default/define/live-audio/*.js"
    },
    "./ui/*": {
      "types": "./dist/dev/define/ui/*.d.ts",
      "development": "./dist/dev/define/ui/*.js",
      "default": "./dist/default/define/ui/*.js"
    },
    "./feature/*": {
      "types": "./dist/dev/define/feature/*.d.ts",
      "development": "./dist/dev/define/feature/*.js",
      "default": "./dist/default/define/feature/*.js"
    },
    "./media/mux-video": {
      "types": "./dist/dev/define/media/mux-video/index.d.ts",
      "development": "./dist/dev/define/media/mux-video/index.js",
      "default": "./dist/default/define/media/mux-video/index.js"
    },
    "./media/mux-audio": {
      "types": "./dist/dev/define/media/mux-audio/index.d.ts",
      "development": "./dist/dev/define/media/mux-audio/index.js",
      "default": "./dist/default/define/media/mux-audio/index.js"
    },
    "./media/*": {
      "types": "./dist/dev/define/media/*.d.ts",
      "development": "./dist/dev/define/media/*.js",
      "default": "./dist/default/define/media/*.js"
    },
    "./i18n": {
      "types": "./dist/dev/i18n/index.d.ts",
      "development": "./dist/dev/i18n/index.js",
      "default": "./dist/default/i18n/index.js"
    },
    "./i18n/locales/*": {
      "types": "./dist/dev/i18n/locales/*.d.ts",
      "development": "./dist/dev/i18n/locales/*.js",
      "default": "./dist/default/i18n/locales/*.js"
    },
    "./i18n/text/*": {
      "types": "./dist/dev/i18n/text/*.d.ts",
      "development": "./dist/dev/i18n/text/*.js",
      "default": "./dist/default/i18n/text/*.js"
    },
    "./*.css": "./dist/default/define/*.css",
    "./*": {
      "types": "./dist/dev/define/*.d.ts",
      "development": "./dist/dev/define/*.js",
      "default": "./dist/default/define/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@videojs/core": "10.1.0",
    "@videojs/element": "10.1.0",
    "@videojs/media": "10.1.0",
    "@videojs/native-hls-video": "10.1.0",
    "@videojs/spf": "10.1.0",
    "@videojs/store": "10.1.0",
    "@videojs/utils": "10.1.0"
  },
  "devDependencies": {
    "@videojs/cloudflare-video": "10.1.0",
    "@videojs/dash-video": "10.1.0",
    "@videojs/google-cast": "10.1.0",
    "@videojs/hlsjs-video": "10.1.0",
    "@videojs/icons": "10.1.0",
    "@videojs/mux-audio": "10.1.0",
    "@videojs/mux-data": "10.1.0",
    "@videojs/mux-video": "10.1.0",
    "@videojs/playerjs-video": "10.1.0",
    "@videojs/shaka-video": "10.1.0",
    "@videojs/skins": "10.1.0",
    "@videojs/spotify-audio": "10.1.0",
    "@videojs/tiktok-video": "10.1.0",
    "@videojs/twitch-video": "10.1.0",
    "@videojs/vimeo-video": "10.1.0",
    "@videojs/wistia-video": "10.1.0",
    "@videojs/youtube-video": "10.1.0",
    "happy-dom": "^20.11.1",
    "vite-plus": "1.0.0"
  },
  "peerDependencies": {
    "@videojs/cloudflare-video": "10.1.0",
    "@videojs/dash-video": "10.1.0",
    "@videojs/google-cast": "10.1.0",
    "@videojs/hlsjs-video": "10.1.0",
    "@videojs/mux-audio": "10.1.0",
    "@videojs/mux-data": "10.1.0",
    "@videojs/mux-video": "10.1.0",
    "@videojs/playerjs-video": "10.1.0",
    "@videojs/shaka-video": "10.1.0",
    "@videojs/spotify-audio": "10.1.0",
    "@videojs/tiktok-video": "10.1.0",
    "@videojs/twitch-video": "10.1.0",
    "@videojs/vimeo-video": "10.1.0",
    "@videojs/wistia-video": "10.1.0",
    "@videojs/youtube-video": "10.1.0"
  },
  "peerDependenciesMeta": {
    "@videojs/cloudflare-video": {
      "optional": true
    },
    "@videojs/dash-video": {
      "optional": true
    },
    "@videojs/google-cast": {
      "optional": true
    },
    "@videojs/hlsjs-video": {
      "optional": true
    },
    "@videojs/mux-audio": {
      "optional": true
    },
    "@videojs/mux-data": {
      "optional": true
    },
    "@videojs/mux-video": {
      "optional": true
    },
    "@videojs/playerjs-video": {
      "optional": true
    },
    "@videojs/shaka-video": {
      "optional": true
    },
    "@videojs/spotify-audio": {
      "optional": true
    },
    "@videojs/tiktok-video": {
      "optional": true
    },
    "@videojs/twitch-video": {
      "optional": true
    },
    "@videojs/vimeo-video": {
      "optional": true
    },
    "@videojs/wistia-video": {
      "optional": true
    },
    "@videojs/youtube-video": {
      "optional": true
    }
  },
  "scripts": {
    "build:watch": "vp pack --watch ./src --no-clean",
    "dev": "pnpm run build:watch",
    "test": "vp test run",
    "clean": "rimraf --glob dist docs types '*.tsbuildinfo'"
  }
}